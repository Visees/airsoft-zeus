# Copy to .env (never commit .env). In Coolify paste these with real values.

# Public address of the site, exactly as users open it (used in emails and share links)
SITE_URL=http://localhost:8080

# Database password (the database and user are both "zeus")
POSTGRES_PASSWORD=change-me-long-random

# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long-random

# Email over SMTP port 587 (Brevo, Resend, Mailjet...). Locally the override uses Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true only for port 465 (SSL from the start); 587 uses STARTTLS automatically.
SMTP_SECURE=false
MAIL_FROM=Airsoft Zeus <no-reply@your-domain.com>

# Google Maps JavaScript API key (restrict it to your domain) and an optional vector Map ID.
# Without a key the app uses its offline schematic map.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Web Push keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com

# Platform admins (comma-separated emails): they publish the News shown on the home page.
ADMIN_EMAILS=

# Demo data (flagged as test data) on first start; keep false in production.
SEED_DEMO_DATA=false
SEED_PASSWORD=zeus-demo-2026

# Local only
LOCAL_WEB_PORT=8080
LOCAL_PG_PORT=5433
LOCAL_MAIL_PORT=8025
